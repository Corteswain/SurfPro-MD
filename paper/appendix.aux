\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Binary presence matrix showing which RDKit features appear in the top-20 SHAP importance list for each target. Each row is one feature; each column is one target. Filled cells indicate membership in the top-20 list; the right-hand column reports the count of targets in which the feature appears.}}{6}{figure.caption.2}\protected@file@percent }
\newlabel{fig:shap_presence}{{2}{6}{Binary presence matrix showing which RDKit features appear in the top-20 SHAP importance list for each target. Each row is one feature; each column is one target. Filled cells indicate membership in the top-20 list; the right-hand column reports the count of targets in which the feature appears}{figure.caption.2}{}}
\newlabel{fig:shap_presence@cref}{{[figure][2][]2}{[1][1][]6}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Distribution of cross-target sharing among the top-20 SHAP features. Each bar shows the number of distinct RDKit descriptors that appear in the top-20 list for exactly $k$ targets ($k = 1, \ldots  , 9$). Most features are target-specific; a small subset recurs across three or more models.}}{7}{figure.caption.3}\protected@file@percent }
\newlabel{fig:shap_count_dist}{{3}{7}{Distribution of cross-target sharing among the top-20 SHAP features. Each bar shows the number of distinct RDKit descriptors that appear in the top-20 list for exactly $k$ targets ($k = 1, \ldots , 9$). Most features are target-specific; a small subset recurs across three or more models}{figure.caption.3}{}}
\newlabel{fig:shap_count_dist@cref}{{[figure][3][]3}{[1][1][]7}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Heatmap of normalised mean $|\text  {SHAP}|$ for features that appear in the top-20 list of at least two targets. Values within each target column are normalised so that the maximum is 1. The label suffix $\times k$ indicates the number of targets for which the feature is in the top-20. Features are sorted by the number of targets in which they appear.}}{8}{figure.caption.4}\protected@file@percent }
\newlabel{fig:shap_heatmap}{{4}{8}{Heatmap of normalised mean $|\text {SHAP}|$ for features that appear in the top-20 list of at least two targets. Values within each target column are normalised so that the maximum is 1. The label suffix $\times k$ indicates the number of targets for which the feature is in the top-20. Features are sorted by the number of targets in which they appear}{figure.caption.4}{}}
\newlabel{fig:shap_heatmap@cref}{{[figure][4][]4}{[1][1][]8}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Grouped bar chart of features appearing in the top-20 SHAP list for three or more targets (``universal'' features). Each group of bars shows the normalised mean $|\text  {SHAP}|$ for one feature across the targets in which it appears.}}{9}{figure.caption.5}\protected@file@percent }
\newlabel{fig:shap_universal}{{5}{9}{Grouped bar chart of features appearing in the top-20 SHAP list for three or more targets (``universal'' features). Each group of bars shows the normalised mean $|\text {SHAP}|$ for one feature across the targets in which it appears}{figure.caption.5}{}}
\newlabel{fig:shap_universal@cref}{{[figure][5][]5}{[1][1][]9}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Decay of mean $|\text  {SHAP}|$ as a function of feature rank (log scale) for each of the nine targets. The shaded region marks the top-20 features. Dashed vertical lines indicate the ranks at which 50\% and 80\% of the cumulative SHAP importance is captured.}}{10}{figure.caption.6}\protected@file@percent }
\newlabel{fig:shap_decay_grid}{{6}{10}{Decay of mean $|\text {SHAP}|$ as a function of feature rank (log scale) for each of the nine targets. The shaded region marks the top-20 features. Dashed vertical lines indicate the ranks at which 50\% and 80\% of the cumulative SHAP importance is captured}{figure.caption.6}{}}
\newlabel{fig:shap_decay_grid@cref}{{[figure][6][]6}{[1][1][]10}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Overlay of normalised SHAP decay curves for all nine targets. Each curve is scaled so that its maximum equals 1. All targets show rapid importance decay, with most predictive signal concentrated in the top 20--30 features.}}{11}{figure.caption.7}\protected@file@percent }
\newlabel{fig:shap_decay_overlay}{{7}{11}{Overlay of normalised SHAP decay curves for all nine targets. Each curve is scaled so that its maximum equals 1. All targets show rapid importance decay, with most predictive signal concentrated in the top 20--30 features}{figure.caption.7}{}}
\newlabel{fig:shap_decay_overlay@cref}{{[figure][7][]7}{[1][1][]11}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Absolute prediction error versus nearest-neighbour distance to the training set in standardised feature space, for all nine target properties. Each point corresponds to one test molecule; colours distinguish the five independent test splits (viridis scale). The Spearman rank correlation $\rho $ is annotated in each panel. Points with NN distance exceeding 40 are excluded; the number of excluded points is noted where non-zero.}}{12}{figure.caption.9}\protected@file@percent }
\newlabel{fig:unc_nndist}{{8}{12}{Absolute prediction error versus nearest-neighbour distance to the training set in standardised feature space, for all nine target properties. Each point corresponds to one test molecule; colours distinguish the five independent test splits (viridis scale). The Spearman rank correlation $\rho $ is annotated in each panel. Points with NN distance exceeding 40 are excluded; the number of excluded points is noted where non-zero}{figure.caption.9}{}}
\newlabel{fig:unc_nndist@cref}{{[figure][8][]8}{[1][3][]12}}
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Absolute prediction error versus ensemble standard deviation for all nine target properties. Each point corresponds to one test molecule; colours distinguish the five independent test splits (viridis scale). The dashed diagonal line indicates perfect correspondence between ensemble standard deviation and absolute error. The Spearman rank correlation $\rho $ is annotated in each panel.}}{13}{figure.caption.10}\protected@file@percent }
\newlabel{fig:unc_ensstd}{{9}{13}{Absolute prediction error versus ensemble standard deviation for all nine target properties. Each point corresponds to one test molecule; colours distinguish the five independent test splits (viridis scale). The dashed diagonal line indicates perfect correspondence between ensemble standard deviation and absolute error. The Spearman rank correlation $\rho $ is annotated in each panel}{figure.caption.10}{}}
\newlabel{fig:unc_ensstd@cref}{{[figure][9][]9}{[1][3][]13}}
