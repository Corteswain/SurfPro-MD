\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:shap_per_target}{{1}{5}{Top-15 features ranked by mean $|\text {SHAP}|$ for each of the nine target properties. Bar colours indicate cross-target sharing: dark blue --- features appearing in the top-20 of three or more targets; light blue --- two targets; grey --- target-specific. The RDKit descriptor names follow the standard RDKit nomenclature}{figure.caption.1}{}}
