\@writefile{toc}{\contentsline {paragraph}{Conformal calibration.}{12}{subsection.3.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces  (\textbf  {a}) Ensemble ML performance across nine target properties, quantified by $R^2$ and Spearman $\rho $ over test splits. (\textbf  {b}-\textbf  {j}) Parity plots for all nine target properties. Each panel shows predictions versus reference values for all five independent held-out test sets; point colours distinguish the five test splits (viridis scale). The dashed lines indicate the identity line. }}{13}{figure.caption.5}\protected@file@percent }
\newlabel{fig:results}{{4}{13}{(\textbf {a}) Ensemble ML performance across nine target properties, quantified by $R^2$ and Spearman $\rho $ over test splits. (\textbf {b}-\textbf {j}) Parity plots for all nine target properties. Each panel shows predictions versus reference values for all five independent held-out test sets; point colours distinguish the five test splits (viridis scale). The dashed lines indicate the identity line}{figure.caption.5}{}}
\newlabel{fig:results@cref}{{[figure][4][]4}{[1][11][]13}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Conformal calibration curves for all nine target properties. Each panel plots nominal coverage $(1-\alpha )$ against empirical coverage (fraction of test molecules whose true value falls within the conformal prediction interval), averaged across five independent test splits. The black diagonal line denotes perfect calibration. Dashed grey lines mark the 90\% nominal and empirical coverage levels. The annotated value shows the empirical coverage achieved at exactly 90\% nominal coverage.}}{14}{figure.caption.7}\protected@file@percent }
\newlabel{fig:unc_conformal}{{5}{14}{Conformal calibration curves for all nine target properties. Each panel plots nominal coverage $(1-\alpha )$ against empirical coverage (fraction of test molecules whose true value falls within the conformal prediction interval), averaged across five independent test splits. The black diagonal line denotes perfect calibration. Dashed grey lines mark the 90\% nominal and empirical coverage levels. The annotated value shows the empirical coverage achieved at exactly 90\% nominal coverage}{figure.caption.7}{}}
\newlabel{fig:unc_conformal@cref}{{[figure][5][]5}{[1][12][]14}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Uncertainty estimation summary. $\rho _\mathrm  {NN}$: Spearman correlation between NN distance (test to training) and absolute prediction error. $\rho _\mathrm  {std}$: Spearman correlation between ensemble standard deviation and absolute prediction error. Empirical coverage columns report the fraction of test molecules whose true value falls within the conformal prediction interval at the given nominal coverage level, averaged across five test splits. Gap @ 0.90 is the signed difference between empirical and nominal coverage at the 90\% level.}}{15}{table.caption.6}\protected@file@percent }
\newlabel{tab:conformal_coverage}{{2}{15}{Uncertainty estimation summary. $\rho _\mathrm {NN}$: Spearman correlation between NN distance (test to training) and absolute prediction error. $\rho _\mathrm {std}$: Spearman correlation between ensemble standard deviation and absolute prediction error. Empirical coverage columns report the fraction of test molecules whose true value falls within the conformal prediction interval at the given nominal coverage level, averaged across five test splits. Gap @ 0.90 is the signed difference between empirical and nominal coverage at the 90\% level}{table.caption.6}{}}
\newlabel{tab:conformal_coverage@cref}{{[table][2][]2}{[1][12][]15}}
