Bootstrap: docker
From: python:3.12-slim

%post
    apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        libxrender1 \
        libxext6 \
        && rm -rf /var/lib/apt/lists/*

    pip install --no-cache-dir \
        numpy==2.2.6 \
        pandas==2.3.3 \
        scipy==1.15.2 \
        scikit-learn==1.7.2 \
        xgboost==3.2.0 \
        optuna==4.8.0 \
        rdkit==2026.3.1 \
        matplotlib==3.10.8 \
        seaborn==0.13.2

%environment
    export PYTHONUNBUFFERED=1

%runscript
    exec python "$@"

%labels
    Description SurfPro-MD surrogate model training environment
